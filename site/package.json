    "sync:vendor": "node scripts/sync-vendor.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vue": "^7.1.2",
    "astro": "^7.4.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
