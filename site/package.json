{
  "name": "stide-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "STide · 潮线 — static public log site for AstrBot agent personas",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check:content && astro build && pagefind --site dist",
