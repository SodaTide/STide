---
import AboutView from '@/views/AboutView.astro';
import { siteConfig, type LocaleCode } from '../../../../site.config';

export function getStaticPaths() {
  return siteConfig.locales
    .filter((locale) => locale.code !== siteConfig.defaultLocale)
    .map((locale) => ({ params: { lang: locale.code }, props: { lang: locale.code as LocaleCode } }));
}

const { lang } = Astro.props;
---

<AboutView locale={lang} />
