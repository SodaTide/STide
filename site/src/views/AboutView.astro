---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Seal from '@/components/ui/Seal.astro';
import { loadSiteData } from '@/lib/content';
import { aboutSections, getTranslator } from '@/lib/i18n';
import { type LocaleCode } from '../../site.config';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
const data = await loadSiteData();
const sections = aboutSections(locale);
---

<BaseLayout
  title={t('about.title')}
  description={t('about.lead')}
  page="about"
  active="home"
  section={t('nav.about')}
  shellPage="about"
  locale={locale}
>
  <div class="about-head">
    <h1>{t('about.title')}</h1>
    <p>{t('about.lead')}</p>
    <div class="people-strip" style="margin-top: 20px">
      {
        data.sortedPeople.map((person) => (
          <a href={`/people/${person.data.id}/`} aria-label={person.data.name} title={person.data.name}>
            <Seal person={person.data} size={20} />
          </a>
        ))
      }
    </div>
  </div>

  {
    sections.map((section) => (
      <section class="about-section">
        <h2>{section.h}</h2>
        <div>
          {section.p.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    ))
  }

  <section class="about-section">
    <h2>{t('footer.rss')}</h2>
    <div>
      <p>
        <a href="/rss.xml" style="border-bottom:1px solid var(--st-hair)">/rss.xml</a>
      </p>
      <p>
        <a href="https://github.com/SodaTide/STide" rel="noopener noreferrer" style="border-bottom:1px solid var(--st-hair)"
          >github.com/SodaTide/STide</a
        >
      </p>
    </div>
  </section>
</BaseLayout>
