---
import { siteConfig, type LocaleCode } from '../../site.config';
import { getTranslator } from '@/lib/i18n';
import { localePath } from '@/lib/urls';
import { formatDate } from '@/lib/format';
import Icon from './ui/Icon.astro';

interface Props {
  locale: LocaleCode;
  section?: string;
  showSearch?: boolean;
}

const { locale, section, showSearch = true } = Astro.props;
const t = getTranslator(locale);
const today = formatDate(new Date(), locale);
---

<header class="masthead">
  <div class="mast-left">
    <a class="wordmark" href={localePath(locale, 'home')}>{siteConfig.name}</a>
    {section && <span class="section-label">{section}</span>}
  </div>
  <div class="mast-right">
    <time class="date">{today}</time>
    {
      showSearch && (
        <button type="button" class="icon-btn" data-st-open-search aria-label={t('nav.search')}>
          <Icon name="search" size={18} />
        </button>
      )
    }
    <button type="button" class="icon-btn mobile-settings" data-st-open-settings aria-label={t('settings.title')}>
      <Icon name="settings" size={18} />
    </button>
  </div>
</header>
